# Cellarium configuration. Copy to .env and adjust. Every variable is optional.

# Where the SQLite database and images are stored.
CELLARIUM_DATA_DIR=./data

# Listening address/port for `python -m cellarium serve` (Docker: keep 0.0.0.0).
CELLARIUM_HOST=127.0.0.1
CELLARIUM_PORT=8770

# First owner account, created at first start if no account exists.
# Without it, the server prints a one-time setup code and the web UI asks you to create the account.
# CELLARIUM_ADMIN_USER=admin
# CELLARIUM_ADMIN_PASSWORD=change-me-please

# Set to true when served over HTTPS (reverse proxy) so session cookies are Secure.
CELLARIUM_SECURE_COOKIES=false
CELLARIUM_SESSION_DAYS=30

# Optional AI image generation (OpenAI-compatible /images/generations API).
# The "Generate (AI)" button is hidden when no key is set.
# CELLARIUM_IMAGE_API_KEY=sk-...
# CELLARIUM_IMAGE_API_BASE=https://api.openai.com/v1
# CELLARIUM_IMAGE_MODEL=gpt-image-1
# CELLARIUM_IMAGE_SIZE=1024x1024
